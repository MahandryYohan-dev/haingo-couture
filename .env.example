# Variables d'environnement pour Haingo Couture (Vercel)
# Copiez ce fichier vers .env.local (dev) ou definissez les variables dans
# les Paramètres Vercel > Variables d'environnement. Ne commitez jamais .env.

# --- URL de base de l'API (vide en dev/local, l'API est sur le meme domaine) ---
VITE_API_BASE=

# --- Authentification admin (serveur /api) ---
# Identifiant admin
ADMIN_USER=admin
# Hash SHA-256 du mot de passe concatené a SESSION_SECRET.
# Generer avec : node -e "console.log(require('crypto').createHash('sha256').update('VOTRE_MOT_DE_PASSE'+'VOTRE_SECRET').digest('hex'))"
ADMIN_PASS_HASH=
# Secret pour signer les cookies de session (chaine aleatoire longue)
SESSION_SECRET=

# --- Contact (FormSubmit) ---
VITE_CONTACT_FORM_ENDPOINT=https://formsubmit.co/ajax/haingomalal@gmail.com

# --- Google Maps (facultatif, surcharge les valeurs par defaut) ---
VITE_MAP_LAT=-18.155389
VITE_MAP_LNG=49.401917
VITE_MAP_DMS=18°09'19.4"S 49°24'06.9"E
